---
import Text from "@components/ui/atoms/Text.astro";
import Button from "@components/ui/atoms/Button.astro";
import { getNovaCopy, getNovaNavigationPath, type NovaLocale } from "@utils/nova-i18n";
import db from "@utils/db";

interface Props {
  locale?: NovaLocale;
}

const { locale = "id" } = Astro.props as Props;
const id = "contact";
const copy = getNovaCopy(locale).footer;

// Ambil kustomisasi footer & CTA dari database SQLite jika ada
const settingRows = db.prepare("SELECT key, value FROM site_settings").all() as { key: string; value: string }[];
const dbSettings: Record<string, string> = {};
for (const s of settingRows) {
  dbSettings[s.key] = s.value;
}

const ownerName = dbSettings.owner_name || "";
const ownerTitle = dbSettings.owner_title || "";
const ownerEmail = dbSettings.owner_email || "";
const ownerPhone = dbSettings.owner_phone || "";
const ownerLocation = dbSettings.owner_location || "";
const ownerBio = dbSettings.owner_bio || "";
const socialGithub = dbSettings.social_github || "";
const socialLinkedin = dbSettings.social_linkedin || "";
const socialTwitter = dbSettings.social_twitter || "";

const eyebrow = dbSettings.footer_eyebrow || copy.eyebrow;
const heading = dbSettings.footer_heading || copy.heading;
const description = dbSettings.footer_description || copy.description;
const primaryLabel = dbSettings.footer_primary_label || copy.primaryLabel;
const primaryHref = dbSettings.footer_primary_href || copy.primaryHref;
const secondaryLabel = dbSettings.footer_secondary_label || copy.secondaryLabel;
const secondaryHref = dbSettings.footer_secondary_href || copy.secondaryHref;
const copyright = dbSettings.footer_copyright || copy.copyright;
const attributionPrefix = dbSettings.footer_attribution_prefix || copy.attributionPrefix;
const attributionLinkLabel = dbSettings.footer_attribution_label || (ownerName || copy.attributionLinkLabel);
const attributionLinkHref = dbSettings.footer_attribution_href || copy.attributionLinkHref;
const footerAbout = dbSettings.footer_about || "";

const footerLinks = copy.footerLinks.map((link) => ({ ...link, href: getNovaNavigationPath(link.href, locale) }));
const legalLinks = copy.legalLinks.map((link) => ({ ...link, href: getNovaNavigationPath(link.href, locale) }));
---

<footer id={id} class="relative overflow-hidden rounded-t-[var(--rounded-lg)] bg-[#0d131f] bg-cover bg-center bg-no-repeat text-white footer-cta-bg">
  <!-- Overlay gelap pekat dengan sedikit gradient agar teks selalu berkontras tinggi dan terbaca jelas -->
  <div class="absolute inset-0 bg-gradient-to-b from-[#090d16]/85 via-[#090d16]/90 to-[#070a10]/95 backdrop-blur-[2px]" aria-hidden="true"></div>
  <div class="ui-container relative z-10 mx-auto grid w-[min(100%-2rem,80rem)] gap-10 py-16 pb-8 sm:py-20">
    <div class="mx-auto max-w-5xl text-center">
      <p class="mb-4 flex items-center justify-center gap-4 text-xs font-bold uppercase tracking-[0.14em] text-brand-accent">
        <span class="h-px w-10 bg-brand-accent/70" aria-hidden="true"></span>
        <span>{eyebrow}</span>
        <span class="h-px w-10 bg-brand-accent/70" aria-hidden="true"></span>
      </p>
      <h2 class="m-0 max-w-none text-[clamp(2.5rem,7vw,5.5rem)] leading-[1.1] tracking-[-0.03em] text-white font-bold lg:whitespace-nowrap">{heading}</h2>
      <p class="mx-auto mt-6 max-w-xl text-[clamp(1rem,1.5vw,1.2rem)] leading-[1.65] text-slate-100 font-medium drop-shadow-sm">{description}</p>
      <div class="mx-auto mt-10 flex w-full max-w-xs flex-col justify-center gap-3 sm:mt-12 sm:max-w-none sm:flex-row">
        <Button href={getNovaNavigationPath(primaryHref, locale)} variant="accent" class="min-h-11 w-full sm:w-auto font-semibold">{primaryLabel}</Button>
        <Button href={getNovaNavigationPath(secondaryHref, locale)} variant="outline" class="min-h-11 w-full !border-white/40 !bg-white/10 !text-white hover:!bg-white/20 sm:w-auto font-semibold backdrop-blur-sm">{secondaryLabel}</Button>
      </div>
    </div>

    <!-- Info Profil & Social Media dari Site Settings CMS -->
    {(ownerEmail || ownerPhone || ownerLocation || socialGithub || socialLinkedin || socialTwitter || footerAbout) && (
      <div class="rounded-2xl border border-white/15 bg-black/50 p-6 sm:p-8 backdrop-blur-md shadow-xl">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-center">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-brand-accent">Kontak & Lokasi</span>
            {ownerName && <h4 class="text-lg font-bold text-white mt-1">{ownerName}</h4>}
            {ownerTitle && <p class="text-xs text-slate-300 font-medium">{ownerTitle}</p>}
            {ownerLocation && <p class="text-xs text-slate-300 mt-1 flex items-center gap-1.5"><i class="ph ph-map-pin text-brand-accent"></i> {ownerLocation}</p>}
          </div>

          <div class="space-y-1.5 text-sm text-slate-200">
            {ownerEmail && (
              <p class="flex items-center gap-2">
                <i class="ph ph-envelope text-brand-accent text-base"></i>
                <a href={`mailto:${ownerEmail}`} class="hover:text-brand-accent text-white font-medium transition-colors">{ownerEmail}</a>
              </p>
            )}
            {ownerPhone && (
              <p class="flex items-center gap-2">
                <i class="ph ph-phone text-brand-accent text-base"></i>
                <a href={`tel:${ownerPhone.replace(/\D/g, '')}`} class="hover:text-brand-accent text-white font-medium transition-colors">{ownerPhone}</a>
              </p>
            )}
            {footerAbout && (
              <p class="text-xs text-slate-300 italic pt-1.5 border-t border-white/15">{footerAbout}</p>
            )}
          </div>

          <div class="flex md:justify-end items-center gap-3">
            {socialGithub && (
              <a href={socialGithub} target="_blank" rel="noreferrer" class="w-10 h-10 rounded-full border border-white/25 bg-white/5 flex items-center justify-center text-white hover:bg-brand-accent hover:text-black hover:border-brand-accent transition-all" aria-label="GitHub">
                <i class="ph ph-github-logo text-lg"></i>
              </a>
            )}
            {socialLinkedin && (
              <a href={socialLinkedin} target="_blank" rel="noreferrer" class="w-10 h-10 rounded-full border border-white/25 bg-white/5 flex items-center justify-center text-white hover:bg-brand-accent hover:text-black hover:border-brand-accent transition-all" aria-label="LinkedIn">
                <i class="ph ph-linkedin-logo text-lg"></i>
              </a>
            )}
            {socialTwitter && (
              <a href={socialTwitter} target="_blank" rel="noreferrer" class="w-10 h-10 rounded-full border border-white/25 bg-white/5 flex items-center justify-center text-white hover:bg-brand-accent hover:text-black hover:border-brand-accent transition-all" aria-label="Twitter">
                <i class="ph ph-twitter-logo text-lg"></i>
              </a>
            )}
          </div>
        </div>
      </div>
    )}

    <div class="flex flex-col items-center gap-8 text-center sm:flex-row sm:items-center sm:justify-between sm:text-left">
      <nav aria-label={copy.ariaLegal} class="flex w-full flex-wrap justify-center gap-x-6 gap-y-3 sm:w-auto sm:justify-start">
        {legalLinks.map((link) => <a href={link.href} class="inline-flex min-h-11 items-center text-sm text-slate-200 transition-colors hover:text-brand-accent sm:min-h-0 font-medium">{link.label}</a>)}
      </nav>
      <nav aria-label={copy.ariaNavigation} class="grid w-full grid-cols-2 gap-x-6 gap-y-3 sm:flex sm:w-auto sm:flex-wrap sm:justify-start lg:justify-end">
        {footerLinks.map((link) => <a href={link.href} class="inline-flex min-h-11 items-center text-sm text-slate-200 transition-colors hover:text-brand-accent sm:min-h-0 font-medium">{link.label}</a>)}
      </nav>
    </div>
    <div class="flex flex-col items-center gap-4 border-t border-white/15 pt-8 text-center text-slate-300 sm:flex-row sm:items-center sm:justify-between sm:text-left text-sm">
      <Text tag="span" variant="feature-body-sm" class="!text-slate-300">
        {copyright}
      </Text>
      <Text tag="span" variant="feature-body-sm" class="sm:text-right !text-slate-300">{attributionPrefix}<a href={attributionLinkHref} target="_blank" rel="noreferrer" class="text-white font-medium transition-colors hover:text-brand-accent underline underline-offset-2 ml-1">{attributionLinkLabel}</a></Text>
    </div>
  </div>
</footer>
