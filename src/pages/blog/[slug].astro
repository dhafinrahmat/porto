---
import Layout from "@/layouts/Layout.astro";
import { db } from "@/utils/db";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/#blog");
}

let post: any = null;
try {
  // Update views counter atomic
  db.prepare("UPDATE posts SET views = views + 1 WHERE slug = ?").run(slug);
  post = db.prepare("SELECT * FROM posts WHERE slug = ? AND status = 'published'").get(slug) as any;
} catch (e) {
  console.error("Error fetching post:", e);
}

if (!post) {
  return Astro.redirect("/404");
}

// Fetch related/recent posts
let recentPosts: any[] = [];
try {
  recentPosts = db.prepare("SELECT * FROM posts WHERE status = 'published' AND id != ? ORDER BY id DESC LIMIT 2").all(post.id) as any[];
} catch {}
---

<Layout title={`${post.title} — Artikel`}>
  <main class="min-h-screen pt-28 pb-20 bg-background text-foreground transition-colors duration-300">
    <article class="ui-container mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb / Back button -->
      <div class="mb-8">
        <a
          href="/#blog"
          class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:underline transition-all group"
        >
          <span class="transition-transform group-hover:-translate-x-1">&larr;</span>
          <span>Kembali ke Beranda & Artikel</span>
        </a>
      </div>

      <!-- Post Header -->
      <header class="mb-10">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-primary/10 text-primary border border-primary/20">
            {post.category || 'Teknologi'}
          </span>
          <span class="text-sm text-muted-foreground flex items-center gap-1.5">
            <i class="ph ph-calendar"></i>
            {post.created_at ? post.created_at.split(' ')[0] : 'Baru'}
          </span>
          <span class="text-sm text-muted-foreground">•</span>
          <span class="text-sm text-muted-foreground flex items-center gap-1.5">
            <i class="ph ph-eye"></i>
            {post.views || 1} tayangan
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-foreground leading-[1.15] mb-6">
          {post.title}
        </h1>

        <div class="flex items-center gap-4 py-4 border-y border-border/40">
          <div class="size-11 rounded-full bg-primary/20 text-primary flex items-center justify-center font-bold text-lg">
            {(post.author || 'F')[0].toUpperCase()}
          </div>
          <div>
            <div class="font-semibold text-foreground text-sm sm:text-base">Ditulis oleh {post.author || 'Finn'}</div>
            <div class="text-xs text-muted-foreground">Software Engineer & Web Architect</div>
          </div>
        </div>
      </header>

      <!-- Featured Image -->
      {post.image && (
        <figure class="mb-12 rounded-2xl overflow-hidden border border-border/40 shadow-xl bg-card">
          <img
            src={post.image}
            alt={post.title}
            class="w-full h-auto max-h-[500px] object-cover"
            loading="eager"
          />
        </figure>
      )}

      <!-- Post Excerpt / Lead -->
      {post.excerpt && (
        <div class="p-6 mb-8 rounded-xl bg-brand-dark/5 dark:bg-card border-l-4 border-primary text-base sm:text-lg text-foreground/90 font-medium leading-relaxed italic">
          "{post.excerpt}"
        </div>
      )}

      <!-- Post Body Content -->
      <div class="prose prose-lg dark:prose-invert max-w-none text-foreground leading-relaxed space-y-6 text-base sm:text-lg">
        {post.content ? (
          post.content.split('\n\n').map((paragraph: string) => (
            <p class="text-foreground/90">{paragraph}</p>
          ))
        ) : (
          <p class="text-muted-foreground italic">Konten artikel sedang dipersiapkan.</p>
        )}
      </div>

      <!-- Footer CTA / Share -->
      <div class="mt-14 pt-8 border-t border-border/50 flex flex-col sm:flex-row items-center justify-between gap-4">
        <a
          href="/#blog"
          class="ui-button ui-button-primary px-6 py-2.5 rounded-full text-sm font-semibold inline-flex items-center gap-2"
        >
          <span>&larr; Lihat Artikel Lainnya</span>
        </a>
        <a
          href="/#contact"
          class="text-sm font-medium text-muted-foreground hover:text-primary transition-colors"
        >
          Punya pertanyaan seputar artikel ini? <span class="underline">Hubungi saya</span>
        </a>
      </div>

      <!-- Recent Posts Section -->
      {recentPosts && recentPosts.length > 0 && (
        <section class="mt-20 pt-12 border-t border-border/60">
          <h3 class="text-2xl font-bold tracking-tight text-foreground mb-6">Artikel Terkait Lainnya</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {recentPosts.map((r) => (
              <a
                href={`/blog/${r.slug}`}
                class="group flex flex-col rounded-xl bg-card border border-border/60 p-5 hover:border-primary transition-all duration-300"
              >
                <div class="text-xs font-semibold text-primary uppercase mb-2">{r.category}</div>
                <h4 class="font-bold text-foreground group-hover:text-primary transition-colors mb-2 line-clamp-2">
                  {r.title}
                </h4>
                <p class="text-xs text-muted-foreground line-clamp-2 mb-4">
                  {r.excerpt || r.content?.slice(0, 100)}
                </p>
                <span class="text-xs font-semibold text-primary group-hover:translate-x-1 transition-transform inline-flex items-center gap-1 mt-auto">
                  Baca Artikel &rarr;
                </span>
              </a>
            ))}
          </div>
        </section>
      )}
    </article>
  </main>
</Layout>
