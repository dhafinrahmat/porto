---
import AdminLayout from '@/layouts/AdminLayout.astro';
import db from '@utils/db';

export const prerender = false;

const faqs = db.prepare('SELECT * FROM faqs ORDER BY sort_order ASC, id ASC').all() as any[];
---

<AdminLayout title="Manage FAQs" activeMenu="faqs">
  <div class="row">
    <div class="col-12 mb-4">
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="mb-0">Daftar Tanya Jawab (Frequently Asked Questions)</h5>
          <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#faqModal" id="addFaqBtn">
            <i class="bx bx-plus me-1"></i> Tambah FAQ Baru
          </button>
        </div>
        <div class="table-responsive text-nowrap">
          <table class="table table-hover">
            <thead>
              <tr>
                <th>Pertanyaan</th>
                <th>Jawaban</th>
                <th>Urutan</th>
                <th>Aksi</th>
              </tr>
            </thead>
            <tbody class="table-border-bottom-0">
              {faqs.map((f) => (
                <tr id={`row-${f.id}`}>
                  <td><strong>{f.question}</strong></td>
                  <td class="text-truncate" style="max-width: 380px;">{f.answer}</td>
                  <td>#{f.sort_order}</td>
                  <td>
                    <div class="dropdown">
                      <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                        <i class="bx bx-dots-vertical-rounded"></i>
                      </button>
                      <div class="dropdown-menu">
                        <a
                          class="dropdown-item edit-btn"
                          href="javascript:void(0);"
                          data-id={f.id}
                          data-question={f.question}
                          data-answer={f.answer}
                          data-order={f.sort_order}
                        >
                          <i class="bx bx-edit-alt me-1"></i> Edit
                        </a>
                        <a class="dropdown-item text-danger delete-btn" href="javascript:void(0);" data-id={f.id}>
                          <i class="bx bx-trash me-1"></i> Hapus
                        </a>
                      </div>
                    </div>
                  </td>
                </tr>
              ))}
              {faqs.length === 0 && (
                <tr>
                  <td colspan="4" class="text-center py-4 text-muted">Belum ada FAQ.</td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal FAQ Form -->
  <div class="modal fade" id="faqModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="modalTitle">Tambah FAQ</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form id="faqForm">
          <div class="modal-body">
            <input type="hidden" id="faqId" />
            <div class="mb-3">
              <label for="question" class="form-label">Pertanyaan (Question)</label>
              <input type="text" id="question" class="form-control" placeholder="Contoh: Berapa lama waktu pengerjaan website?" required />
            </div>
            <div class="mb-3">
              <label for="answer" class="form-label">Jawaban (Answer)</label>
              <textarea id="answer" class="form-control" rows="3" placeholder="Jelaskan jawaban secara ramah dan jelas..." required></textarea>
            </div>
            <div class="mb-3">
              <label for="sort_order" class="form-label">Urutan</label>
              <input type="number" id="sort_order" class="form-control" value="1" required />
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Batal</button>
            <button type="submit" class="btn btn-primary" id="saveFaqBtn">Simpan</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script is:inline>
    let isEditing = false;
    const modalTitle = document.getElementById('modalTitle');
    const faqForm = document.getElementById('faqForm');
    const addBtn = document.getElementById('addFaqBtn');

    addBtn.addEventListener('click', () => {
      isEditing = false;
      modalTitle.innerText = 'Tambah FAQ';
      document.getElementById('faqId').value = '';
      faqForm.reset();
      document.getElementById('sort_order').value = '1';
    });

    document.querySelectorAll('.edit-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        isEditing = true;
        modalTitle.innerText = 'Edit FAQ';
        const d = btn.dataset;
        document.getElementById('faqId').value = d.id;
        document.getElementById('question').value = d.question;
        document.getElementById('answer').value = d.answer;
        document.getElementById('sort_order').value = d.order;
        
        const modal = new bootstrap.Modal(document.getElementById('faqModal'));
        modal.show();
      });
    });

    document.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.id;
        if (!confirm('Hapus FAQ ini?')) return;

        try {
          const res = await fetch('/api/admin/faqs', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'delete', id }),
          });
          if (res.ok) {
            document.getElementById(`row-${id}`)?.remove();
          } else {
            alert('Gagal menghapus');
          }
        } catch (err) {
          alert('Error: ' + err.message);
        }
      });
    });

    faqForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = document.getElementById('faqId').value;
      const question = document.getElementById('question').value;
      const answer = document.getElementById('answer').value;
      const sort_order = document.getElementById('sort_order').value;

      const payload = {
        action: isEditing ? 'update' : 'create',
        id,
        question,
        answer,
        sort_order,
      };

      try {
        const res = await fetch('/api/admin/faqs', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (res.ok) {
          location.reload();
        } else {
          const r = await res.json();
          alert('Error: ' + (r.error || 'Gagal menyimpan'));
        }
      } catch (err) {
        alert('Connection error: ' + err.message);
      }
    });
  </script>
</AdminLayout>
